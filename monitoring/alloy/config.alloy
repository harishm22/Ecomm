local.file_match "services_logs" {
    path_targets = [{"__path__" = "/var/log/services/**/logs/*.json", "job" = "simpleecom-logs"}]
}

loki.source.file "services_logs" {
    targets    = local.file_match.services_logs.targets
    forward_to = [loki.process.parse_json.receiver]
}

loki.process "parse_json" {
    forward_to = [loki.write.default.receiver]
    
    stage.json {
        expressions = {
            service = "service",
            level   = "level",
            traceId = "traceId",
            logger  = "logger_name",
            message = "message",
        }
    }
    
    stage.labels {
        values = {
            service = "service",
            level   = "level",
            traceId = "traceId",
        }
    }
}

loki.write "default" {
    endpoint {
        url = "http://loki:3100/loki/api/v1/push"
    }
}
